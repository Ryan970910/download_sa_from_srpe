# Downloaded PDFs (6+ GB) — keep locally, never commit.
# The dev_id folders are reproducible by running `py main.py`.
downloads/

# Link cache (optional, large) — keep locally.
cache/

# Run logs.
logs/

# Extraction outputs (regenerable by running build_excels.py).
# Note: all_sa_info.xlsx IS committed as a sample result.
extracted/

# Large archives / zips of the downloads (you transfer these separately).
*.zip

# Python.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Playwright browsers (downloaded on demand).
ms-playwright/

# OS / editor.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
